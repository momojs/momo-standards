// markdownlint 配置：https://github.com/DavidAnson/markdownlint
{
  "default": true,
  // 标题层级逐级递增，不跳级
  "MD001": true,
  // 使用 # 风格标题
  "MD003": { "style": "atx" },
  // 无序列表统一使用 -
  "MD004": { "style": "dash" },
  // 标题前后留空行
  "MD022": true,
  // 同一文档内允许不同章节下出现同名子标题
  "MD024": { "siblings_only": true },
  // 框架通过 frontmatter title 生成一级标题时，正文可以没有一级标题
  "MD025": { "front_matter_title": "^\\s*title\\s*[:=]" },
  // 标题末尾不使用这些标点（问号、叹号允许）
  "MD026": { "punctuation": ".,;:。，；：、" },
  // 中文没有固定行宽，不限制行长度
  "MD013": false,
  // 允许 MDX / 文档框架使用内联 HTML
  "MD033": false,
  // 不直接粘贴裸 URL
  "MD034": true,
  // 代码块必须标注语言
  "MD040": true,
  // frontmatter 生成标题时，首行可以不是一级标题
  "MD041": false
}
